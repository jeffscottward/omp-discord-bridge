[Unit]
Description=Local Whisper for omp-discord-bot voice messages (model kept loaded on the GPU)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/Github/tools/omp-discord-bot
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/mise/shims/uv run --quiet scripts/whisper_server.py
Restart=on-failure
RestartSec=20
Nice=5

[Install]
WantedBy=default.target
